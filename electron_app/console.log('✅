  t = now();
  const revTx = await accumulator.revokeDoctor(doctor.did);
  const revReceipt = await revTx.wait();
  times.revokeDoctor = elapsed(t);
  console.log(`   Revoked in ${times.revokeDoctor.toFixed(2)} ms, gas: ${revReceipt.gasUsed}`);

