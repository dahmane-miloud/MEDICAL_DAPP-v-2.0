  const ehrBuffer = Buffer.from(ehr, 'utf-8');
  const aesKey = crypto.randomBytes(32);

  t = now();
  const encryptedEHR = aesEncrypt(ehrBuffer, aesKey);
  times.aesEncrypt = elapsed(t);
  console.log(`   AES-256 GCM encryption done in ${times.aesEncrypt.toFixed(2)} ms`);

  console.log('☁️  Patient: uploading encrypted EHR to Pinata...');
  t = now();
  const ehrCID = await pinataUpload(encryptedEHR, 'ehr.enc');
  times.pinataUpload = elapsed(t);
  console.log(`   CID: ${ehrCID}  (${times.pinataUpload.toFixed(2)} ms)`);

  // ---- DOCTOR ----
  console.log('👨‍⚕️  Doctor: generating SSI...');
  t = now();
  const doctor = generateSSI();
  times.doctorSSI = elapsed(t);
  console.log(`   DID: ${doctor.did}  (${times.doctorSSI.toFixed(2)} ms)`);

  // ---- REGISTER DOCTOR ON PROXY (prevents 404) ----
  console.log('🔑 Registering doctor on TB‑PRE proxy...');
  t = now();
  await proxyRegisterDoctor(doctor.did, ['doctor']);
  times.proxyRegisterDoctor = elapsed(t);
  console.log(`   Registered in ${times.proxyRegisterDoctor.toFixed(2)} ms`);

  // ---- HEALTH DEPT ISSUES WITNESS ----
  console.log('🏥 Health Dept: issuing witness for doctor...');
  const witnessExpiry = Math.floor(Date.now() / 1000) + CONFIG.WITNESS_VALIDITY_DAYS * 86400;
  const witnessStr = 'witness_' + Date.now();
  const witnessHash = ethers.keccak256(ethers.toUtf8Bytes(witnessStr));

  t = now();
  const tx = await accumulator.setDoctorWitness(doctor.did, witnessHash, witnessExpiry);
  const receipt = await tx.wait();
  times.setDoctorWitness = elapsed(t);
  console.log(`   Tx hash: ${tx.hash}, gas used: ${receipt.gasUsed}  (${times.setDoctorWitness.toFixed(2)} ms)`);

  // ---- PATIENT VERIFIES DOCTOR ACTIVE ----
  console.log('🔍 Patient: checking doctor active on blockchain...');
  t = now();
  const active = await accumulator.isDoctorActive(doctor.did);
  times.checkActive = elapsed(t);
  console.log(`   Is active: ${active}  (${times.checkActive.toFixed(2)} ms)`);
  if (!active) throw new Error('Doctor not active!');

  // ---- PATIENT ENCAPSULATES AES KEY (PRE) ----
  console.log('🔑 Patient: encrypting AES key with proxy (PRE encapsulation)...');
  const timeSlot = Math.floor(Date.now() / 1000 / 3600);
  const policy = [["doctor"]];
  t = now();
  const proxyEncResult = await proxyEncryptAES(aesKey.toString('base64'), policy, timeSlot);
  times.proxyEncrypt = elapsed(t);
  console.log(`   Ciphertext ID: ${proxyEncResult.ciphertext_id}  (${times.proxyEncrypt.toFixed(2)} ms)`);

  // ---- DOCTOR ACCESS ----
  console.log('📨 Doctor: requesting re-encryption from proxy...');
  t = now();
  const rekeyId = await proxyGenerateRekey(proxyEncResult.ciphertext_id, doctor.did, ['doctor']);
  times.proxyRekey = elapsed(t);
  console.log(`   Rekey ID: ${rekeyId}  (${times.proxyRekey.toFixed(2)} ms)`);

  console.log('🔄 Proxy: re-encrypting (transform) ...');
  t = now();
  const transformedCtId = await proxyReencrypt(rekeyId);
  times.proxyReencrypt = elapsed(t);
  console.log(`   Transformed ciphertext ID: ${transformedCtId}  (${times.proxyReencrypt.toFixed(2)} ms)`);

  console.log('🔓 Doctor: decrypting AES key via proxy...');
  t = now();
  const aesKeyB64 = await proxyDecryptAES(transformedCtId, doctor.did);
  times.proxyDecryptAES = elapsed(t);
  console.log(`   AES key recovered in ${times.proxyDecryptAES.toFixed(2)} ms`);

  // ---- DOWNLOAD & DECRYPT EHR ----
  console.log('⬇️  Doctor: downloading encrypted EHR from Pinata...');
  t = now();
  const encData = await pinataDownload(ehrCID);
  times.pinataDownload = elapsed(t);
  console.log(`   Downloaded in ${times.pinataDownload.toFixed(2)} ms`);

  console.log('📄 Doctor: decrypting EHR with retrieved AES key...');
