// ==================== PROXY HELPERS ====================
async function proxyRegisterDoctor(did, attributes = ["doctor"]) {
  await axios.post(`${CONFIG.PROXY_URL}/register_doctor`, {
    doctor_did: did,
    attributes: attributes,
  });
}

async function proxyEncryptAES(aesKeyB64, policy, timeSlot) {
  const res = await axios.post(`${CONFIG.PROXY_URL}/encrypt_aes`, {
    aes_key_b64: aesKeyB64,
    policy: policy,
    time_slot: timeSlot,
  });
  return res.data; // { ciphertext_id, ciphertext }
}

async function proxyGenerateRekey(ctId, delegateeDid, attrs) {
  const res = await axios.post(`${CONFIG.PROXY_URL}/generate_rekey`, {
    ct_id: ctId,
    delegatee_did: delegateeDid,
    delegatee_attrs: attrs,
  });
  return res.data.rekey_id;
}

async function proxyReencrypt(rekeyId) {
  const res = await axios.post(`${CONFIG.PROXY_URL}/proxy_reencrypt`, { rekey_id: rekeyId });
  return res.data.transformed_ct_id;
}

async function proxyDecryptAES(transformedCtId, doctorDid) {
  const res = await axios.post(`${CONFIG.PROXY_URL}/decrypt_aes`, {
    transformed_ct_id: transformedCtId,
    doctor_did: doctorDid,
  });
  return res.data.aes_key_b64;
}

// ==================== HIGH‑RES TIMER ====================
function now() { return process.hrtime.bigint(); }
function elapsed(start) { return Number(now() - start) / 1_000_000; } // ms

// ==================== MAIN WORKFLOW ====================
async function runWorkflow() {
  const times = {};
  let startAll = now();

  // ---- PATIENT ----
