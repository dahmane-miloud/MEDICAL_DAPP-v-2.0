  const aesKeyDoctor = Buffer.from(aesKeyB64, 'base64');
  const decryptedEHR = aesDecrypt(encData, aesKeyDoctor);
  times.aesDecrypt = elapsed(t);
  console.log(`   Decrypted in ${times.aesDecrypt.toFixed(2)} ms`);

